<clickhouse>
 <!-- Required for the Grafana reader's bounded changeable_in_readonly exception. -->
 <access_control_improvements>
  <settings_constraints_replace_previous>true</settings_constraints_replace_previous>
 </access_control_improvements>
 <max_server_memory_usage>1610612736</max_server_memory_usage>
 <!-- Background pools already consume ~121 global workers on the pinned image.
      Leave bounded query headroom; match the scheduled-job limit to the pool. -->
 <max_thread_pool_size>512</max_thread_pool_size>
 <thread_pool_queue_size>512</thread_pool_queue_size>
 <max_thread_pool_free_size>128</max_thread_pool_free_size>
 <background_schedule_pool_size>8</background_schedule_pool_size>
 <background_pool_size>16</background_pool_size>
 <background_move_pool_size>2</background_move_pool_size>
 <background_fetches_pool_size>2</background_fetches_pool_size>
 <background_common_pool_size>2</background_common_pool_size>
 <logger><level>warning</level><size>2M</size><count>1</count></logger>
 <query_log remove="1"/><query_thread_log remove="1"/><query_views_log remove="1"/>
 <part_log remove="1"/><trace_log remove="1"/><text_log remove="1"/>
 <metric_log remove="1"/><asynchronous_metric_log remove="1"/><processors_profile_log remove="1"/>
</clickhouse>
