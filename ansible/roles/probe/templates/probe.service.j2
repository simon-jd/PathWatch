[Unit]
Description=PathWatch physical observer
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5
[Service]
User={{ pathwatch_probe_user }}
Group={{ pathwatch_probe_user }}
WorkingDirectory={{ pathwatch_probe_state }}
ExecStart={{ pathwatch_probe_root }}/probe -config {{ pathwatch_probe_root }}/probe.json
{% if pathwatch_probe_target_ca_file | length > 0 %}
Environment=SSL_CERT_FILE={{ pathwatch_probe_root }}/target-ca.pem
{% endif %}
Restart=on-failure
RestartSec=15
TimeoutStopSec=15
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
ReadWritePaths={{ pathwatch_probe_state }} /var/log/pathwatch-probe
MemoryMax=256M
TasksMax=128
UMask=0077
StandardOutput=append:/var/log/pathwatch-probe/probe.log
StandardError=append:/var/log/pathwatch-probe/probe.log
[Install]
WantedBy=multi-user.target
